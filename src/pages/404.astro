---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada / Page not found — Thexify" errorPage>
  <section class="not-found">
    <p class="eyebrow">404 / FUERA DEL MAPA · OFF THE MAP</p>
    <h1>
      Esta página
      <br />
      <span>no existe.</span>
    </h1>
    <p class="not-found-en" lang="en">
      This page doesn’t exist, but the rest of Thexify is right where it should be.
    </p>
    <div class="not-found-actions">
      <a class="pill-link pill-link--green" href="/">
        Volver al inicio <span aria-hidden="true">↗</span>
      </a>
      <a class="pill-link" href="/en/" lang="en">
        Go to English site <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 68vh;
    padding: 110px var(--gutter) 130px;
  }

  .not-found > .eyebrow {
    color: var(--green);
  }

  h1 {
    margin: 30px 0;
    font-size: clamp(48px, 7vw, 105px);
    font-weight: 550;
    line-height: 1.02;
    letter-spacing: -0.065em;
  }

  h1 span {
    color: var(--muted);
  }

  .not-found-en {
    max-width: 520px;
    color: var(--copy);
    font-size: 17px;
    line-height: 1.7;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 38px;
  }

  @media (max-width: 560px) {
    .not-found {
      padding-block: 75px 95px;
    }

    .not-found-actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
