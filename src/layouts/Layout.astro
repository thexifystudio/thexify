---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Arrow from '../components/Arrow.astro';
import { site, whatsappHref } from '../data/site';
interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  alternatePath?: string;
  errorPage?: boolean;
}
const {
  title,
  description = 'Diseño y desarrollo web para negocios que quieren dar el siguiente paso. Sitios web, plataformas con panel y tiendas Shopify. Desde Quito, para el mundo.',
  lang = 'es',
  alternatePath = lang === 'es' ? '/en/' : '/',
  errorPage = false,
} = Astro.props;
const en = lang === 'en';
const home = en ? '/en/' : '/';
const contact = en ? '/en/contact/' : '/contacto/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const esUrl = new URL(en ? alternatePath : Astro.url.pathname, Astro.site);
const enUrl = new URL(en ? Astro.url.pathname : alternatePath, Astro.site);
const companyDescription = en
  ? 'Independent web design and development studio in Quito, Ecuador. Websites, admin platforms and Shopify stores for businesses.'
  : 'Estudio independiente de diseño y desarrollo web en Quito, Ecuador. Sitios web, plataformas con panel y tiendas Shopify para negocios.';
const whatsapp = whatsappHref(
  en
    ? 'Hello Thexify, I would like to discuss a project.'
    : 'Hola Thexify, quisiera conversar sobre un proyecto.',
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: companyDescription,
  email: site.email,
  areaServed: ['Ecuador', 'Latin America', 'United States'],
  address: { '@type': 'PostalAddress', addressLocality: 'Quito', addressCountry: 'EC' },
  knowsLanguage: ['es', 'en'],
  serviceType: ['Web design', 'Web development', 'Shopify development'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101110" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {errorPage ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        en
          ? 'Thexify — Thoughtfully designed. Precisely built.'
          : 'Thexify — Diseño con intención. Código con precisión.'
      }
    />
    <meta property="og:locale" content={en ? 'en_US' : 'es_EC'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {en ? 'Skip to content' : 'Saltar al contenido'}
    </a>
    <header class="site-header">
      <a class="brand" href={home} aria-label={en ? 'Thexify, home' : 'Thexify, inicio'}>
        <Mark />
        <span>
          thexify<span class="brand-dot">✳</span>
        </span>
      </a>
      <nav class="desktop-nav" aria-label={en ? 'Main navigation' : 'Navegación principal'}>
        <a href={`${home}#servicios`}>{en ? 'Services' : 'Servicios'}</a>
        <a href={`${home}#estudio`}>{en ? 'Why Thexify' : 'Por qué Thexify'}</a>
        <a href={`${home}#proceso`}>{en ? 'Process' : 'Proceso'}</a>
        <a href={`${home}#proyectos`}>{en ? 'Work' : 'Proyectos'}</a>
      </nav>
      <div class="header-actions">
        <a
          class="language-switch"
          href={alternatePath}
          lang={en ? 'es' : 'en'}
          aria-label={en ? 'Cambiar a español' : 'Switch to English'}
        >
          {en ? 'ES' : 'EN'}
        </a>
        <a class="header-cta" href={contact}>
          {en ? 'Let’s talk' : 'Cotizar'}
          <Arrow />
        </a>
        <button
          class="menu-toggle"
          data-menu-toggle
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label={en ? 'Open navigation menu' : 'Abrir menú de navegación'}
        >
          <span></span>
          <span></span>
        </button>
      </div>
      <nav
        id="mobile-menu"
        class="mobile-menu"
        data-menu-panel
        hidden
        aria-label={en ? 'Mobile navigation' : 'Navegación móvil'}
      >
        <a href={`${home}#servicios`}>{en ? 'Services' : 'Servicios'}</a>
        <a href={`${home}#estudio`}>{en ? 'Why Thexify' : 'Por qué Thexify'}</a>
        <a href={`${home}#proceso`}>{en ? 'Process' : 'Proceso'}</a>
        <a href={`${home}#proyectos`}>{en ? 'Work' : 'Proyectos'}</a>
        <a href={contact}>
          {en ? 'Start a project' : 'Empezar un proyecto'} <Arrow />
        </a>
        <span class="eyebrow">Quito, Ecuador · {en ? 'Working everywhere' : 'Sin fronteras'}</span>
      </nav>
    </header>
    <noscript>
      <nav class="no-script-nav" aria-label={en ? 'Section navigation' : 'Navegación por secciones'}>
        <a href={`${home}#proyectos`}>{en ? 'Work' : 'Proyectos'}</a>
        <a href={`${home}#estudio`}>{en ? 'Studio' : 'Estudio'}</a>
        <a href={`${home}#servicios`}>{en ? 'Services' : 'Servicios'}</a>
      </nav>
      <style>
        .menu-toggle {
          display: none !important;
        }
      </style>
    </noscript>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="brand" href={home}>
          <Mark />
          <span>thexify</span>
        </a>
        <p>
          {en ? 'Thoughtfully designed. Precisely built.' : 'Diseño con intención. Código con precisión.'}
        </p>
        <a class="text-link" href={contact}>
          {en ? 'Start a conversation' : 'Empecemos a hablar'} <Arrow />
        </a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Thexify Studio</span>
        <span>Quito, Ecuador · {en ? 'Working everywhere' : 'Creamos sin fronteras'}</span>
        <a href={`mailto:${site.email}`}>
          {site.email} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
    {whatsapp && (
      <a
        class="whatsapp-fab"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={
          en
            ? 'Talk to Thexify on WhatsApp (opens in a new tab)'
            : 'Hablar con Thexify por WhatsApp (abre en una pestaña nueva)'
        }
      >
        <span aria-hidden="true">WA</span>
        <strong>{en ? 'WhatsApp' : 'Escríbenos'}</strong>
      </a>
    )}
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
