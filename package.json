{
  "name": "thexify-studio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "cf-typecheck": "wrangler types --env-interface CloudflareEnv --check",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply thexify-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply thexify-db --remote",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "gsap": "3.15.0",
    "jose": "^6.2.12",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "wrangler": "^4.131.2"
  }
}
