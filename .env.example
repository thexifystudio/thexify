# Copy to .env and fill in real values. .env is gitignored.

# WhatsApp number in international format, digits only (country code + number,
# no leading 0, no +, no spaces). Example for Ecuador: 5939XXXXXXXX.
# Inlined at build time (NEXT_PUBLIC_), so rebuild after changing it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Secrets for `next dev` / `npm run preview` go in .dev.vars (see .dev.vars.example),
# never here. Production: npx wrangler secret put AUTH_SECRET
